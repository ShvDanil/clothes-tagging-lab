# Local development only. Use separate credentials for any shared deployment.
POSTGRES_DB=clothes
POSTGRES_USER=clothes
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5433
API_PORT=8000

# Host-side Python; Compose builds its own URL with hostname "db".
DATABASE_URL=postgresql+psycopg://clothes:local-development-only@localhost:5433/clothes
TAXONOMY_PATH=data/taxonomy/clothing-v1.json
MAX_IMAGES_PER_ITEM=5

# Reserved for your implementation: the scaffold does not call any model.
# Add the chosen provider's configuration and document it.
MODEL_API_KEY=
MODEL_ID=

# Dataset download only. Do not commit credentials or temporary signed URLs.
# Configure a read-only AWS CLI profile locally; never add its file to the repo.
DATASET_S3_ENDPOINT=https://storage.yandexcloud.net
DATASET_S3_BUCKET=clothes-tagging
DATASET_S3_REGION=ru-central1
DATASET_S3_PREFIX=prepared/source-v2/
DATASET_AWS_PROFILE=clothes-dataset
